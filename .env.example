# ============================================================
# Colosseum — environment template
# Copy to .env and fill in real values. Never commit .env.
# All secrets are read server-side only.
# ============================================================

# --- External LLM provider (OpenAI-compatible REST) ---
# Base URL + key. Works with OpenAI, OpenRouter, Groq, LocalAI, etc.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=                # e.g. gpt-4o-mini, openrouter/anthropic/claude-3.5-sonnet
LLM_TIMEOUT_SECONDS=60

# --- Supabase (PostgreSQL via PostgREST) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (REST) ---
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# --- Server ---
PORT=8000
HOST=0.0.0.0
# Comma-separated origins allowed for CORS/WebSocket
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional override for the fallback topic pool (default: server/app/topics/fallback_pool.json)
FALLBACK_TOPIC_POOL_FILE=
# Storage backend: supabase (production) | local (file-based; used for dev/test)
STORAGE_MODE=supabase
# Where local storage keeps its JSON files (dev/test only)
DATA_DIR=./data
# Judge model override (defaults to LLM_MODEL if unset)
JUDGE_MODEL=

# --- Debate / scheduling ---
DEBATE_INTERVAL_SECONDS=300
DEBATE_TURNS=20
MAX_NEW_TOKENS=75
TOPICS_PER_HOUR=12
RETENTION_HOURS=48

# --- Inference ---
GENERATION_TEMPERATURE=0.65
GENERATION_TOP_K=25
GENERATION_TOP_P=0.9
GENERATION_REPETITION_PENALTY=1.20